# 1. LiveKit Cloud
LIVEKIT_URL=wss://your-project-domain.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Google Gemini (3rd generation)
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_CONTROLLER_MODEL=gemini-3.5-flash-lite
GEMINI_REPORT_MODEL=gemini-3.8-flash

# 3. Deepgram STT (Vietnamese)
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=vi

# 4. ElevenLabs TTS
ELEVEN_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional public voice identifier; unset preserves the installed SDK default.
# ELEVENLABS_VOICE_ID=

# Local voice conversation test only; never enable on a public service.
APP_ENV=development
LOCAL_VOICE_ENABLED=false
# Generate a separate random secret (at least 32 characters), not a provider key.
LOCAL_VOICE_SECRET=
LOCAL_VOICE_ORIGINS=http://127.0.0.1:3000
LOCAL_VOICE_TOKEN_TTL=60
LOCAL_VOICE_DURATION=300
LOCAL_VOICE_MAX_SESSIONS=1
# Sensitive local pipeline evidence; requires separate browser recording consent.
LOCAL_VOICE_RECORDING=false

# Optional Google sign-in (not GOOGLE_API_KEY); disabled until configured.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
APP_ORIGIN=http://127.0.0.1:3000
# Independent random secret, >=32 characters. Rotation invalidates sessions/flows.
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL=28800
# Frontend build/runtime: set in its separate credential-free environment.
# API_BACKEND_URL=http://127.0.0.1:8000
# All five DATABASE_* fields are required by the explicit auth migration/check.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=openinterview_dev
DATABASE_USER=openinterview
DATABASE_PASSWORD=
